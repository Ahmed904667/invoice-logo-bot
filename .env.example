# ====================================================================
# ASC Invoice Logo Adder Bot - Configuration Template
# ====================================================================

# 1. Obtain your bot token from @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. (Optional) Background image or PDF filename located in this folder:
DEFAULT_BG_NAME=invoiceBg.jpeg

# 3. (Optional) Security: Restrict bot usage to specific Telegram User IDs (comma-separated):
ALLOWED_USER_IDS=

# 4. (Optional) Admin Telegram User IDs who can update the background via /setbg:
ADMIN_USER_IDS=

# 5. (Optional) Maximum upload file size in Megabytes:
MAX_FILE_SIZE_MB=20
